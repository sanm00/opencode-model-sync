{
  "name": "opencode-model-sync",
  "version": "0.1.0",
  "description": "Non-blocking model discovery for OpenAI-compatible OpenCode providers",
  "type": "module",
  "license": "MIT",
  "author": "Sanm",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "bin": {
    "opencode-model-sync": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./installer": {
      "types": "./dist/installer.d.ts",
      "import": "./dist/installer.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "models",
    "openai-compatible"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.25",
    "@opentui/core": "^0.5.9",
    "@opentui/keymap": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "@types/node": "^24.3.0",
    "solid-js": "^1.9.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
